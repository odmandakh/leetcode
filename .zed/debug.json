[
  {
    "label": "Debug LeetCode",
    "build": {
      "command": "cmake",
      "args": ["--build", "build"],
      "cwd": "$ZED_WORKTREE_ROOT"
    },
    "program": "$ZED_WORKTREE_ROOT/build/LeetCode",
    "request": "launch",
    "adapter": "CodeLLDB",
    "dap": {
      "CodeLLDB": {
        "binary": "/Library/Developer/CommandLineTools/usr/bin/lldb-dap"
      }
    }
  }
]
